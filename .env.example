# Environment Configuration for AI Property Video Generator
# NOTE: All keys are OPTIONAL. The app works 100% offline using the built-in
# rule-based NLP template engine and free neural TTS if no key is provided.

# Optional: Google Gemini API Key for dynamic LLM copywriting
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Preferred Default TTS Voice
# Options:
#   en-US-ChristopherNeural (Male, Professional American)
#   en-US-JennyNeural (Female, Warm American)
#   en-IN-NeerjaNeural (Female, Indian English)
#   en-IN-PrabhatNeural (Male, Indian English)
DEFAULT_TTS_VOICE=en-US-ChristopherNeural
